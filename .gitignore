# Dependencies
node_modules/
.pnp/
.pnp.js

# Build
.next/
out/
build/
dist/
.wrangler/

# Created by scripts/next-build.mjs when NEXT_OUTPUT=export is set; should
# be removed automatically but an interrupted build can leave it behind.
.api-parked-for-export/

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Pencil design mockups
*.pen

# GNUCash files (never commit financial data)
*.gnucash
*.gnucash.LNK
*.gnucash.LCK

# But keep test fixtures
!**/fixtures/test.gnucash

# Claude Code
.claude/
CLAUDE.md
AGENTS.md

# Docker
.docker/

# Test coverage
coverage/

# Playwright
playwright.config.ts
playwright-report/
test-results/
# Dev-only automation scripts (Playwright screenshots etc.) live under
# app/scripts/ and are ignored by default; un-ignore specific scripts below
# if they are production build tooling. Git can't re-include files when the
# directory itself is ignored, so we ignore contents instead of the dir.
app/scripts/*
!app/scripts/next-build.mjs

# Internal docs
ROADMAP.md
ARCHITECTURE_REVIEW.md
reddit-post*.md

# GNUCash source reference
gnucash-source/

# Misc
*.log
*.tsbuildinfo
next-env.d.ts
plan/
