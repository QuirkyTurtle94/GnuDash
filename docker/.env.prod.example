# Copy this file to .env.prod and fill in the values. Never commit .env.prod.
#
# Generate SESSION_SECRET with:
#   openssl rand -base64 48
#
# Generate APP_PASSPHRASE_HASH with:
#   cd ../app
#   node -e 'require("@node-rs/argon2").hash("YOUR-PASSPHRASE").then(console.log)'
#
# You'll log in with the passphrase you hashed, not the hash itself.

SESSION_SECRET=replace-me-with-at-least-32-bytes-of-random-junk
APP_PASSPHRASE_HASH=$argon2id$v=19$...paste-from-the-node-command-above...
